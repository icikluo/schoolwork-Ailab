{
  "$schema_说明": "A4 契约：商店道具数据（数据/商店.js）",
  "版本": "1.0",
  "文件名": "商店.js",
  "路径": "数据/商店.js",
  "JS变量": "window.商店数据",
  "类型": "object",
  "字段顺序": ["道具"],
  "字段": {
    "道具": {
      "类型": "array",
      "条数": 2,
      "元素字段顺序": ["id", "价格", "每日上限"],
      "元素字段": {
        "id": { "类型": "string", "枚举": ["零食", "玩具"] },
        "价格": { "类型": "integer", "最小": 1 },
        "每日上限": { "类型": "integer", "最小": 1 }
      }
    }
  },
  "约束": {
    "id唯一": true,
    "价格不可为0": "免费道具不走商店，直接进默认存档"
  }
}