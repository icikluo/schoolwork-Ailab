{
  "$schema_说明": "A4 契约：食谱数据（数据/foods.json 与 数据/食谱.js 同构）",
  "版本": "1.0",
  "文件名": "foods.json",
  "路径": "数据/foods.json",
  "类型": "array",
  "最少条数": 40,
  "字段顺序": ["id", "名称", "人群", "卡路里", "碳水", "脂肪", "膳食纤维", "蛋白质", "食材", "步骤", "图片"],
  "字段": {
    "id": {
      "类型": "string",
      "格式": "^r\\d{3}$",
      "唯一": true,
      "说明": "r + 三位数字，与 数据/图片/<id>.jpg 对应"
    },
    "名称": { "类型": "string", "非空": true },
    "人群": {
      "类型": "array",
      "元素类型": "string",
      "枚举": ["减脂", "增肌", "控糖", "均衡"],
      "非空数组": true,
      "说明": "一道菜可同时属于多个人群"
    },
    "卡路里": { "类型": "integer", "最小": 0, "最大": 3000 },
    "碳水": { "类型": "number", "最小": 0, "小数位最多": 1 },
    "脂肪": { "类型": "number", "最小": 0, "小数位最多": 1 },
    "膳食纤维": { "类型": "number", "最小": 0, "小数位最多": 1 },
    "蛋白质": { "类型": "number", "最小": 0, "小数位最多": 1 },
    "食材": { "类型": "string", "非空": true },
    "步骤": {
      "类型": "array",
      "元素类型": "string",
      "非空数组": true,
      "最少条数": 1,
      "说明": "每条为一句话的烹饪步骤"
    },
    "图片": {
      "类型": "string",
      "本地路径": true,
      "允许为空": true,
      "说明": "相对 自选作品/ 的本地路径；空串表示暂无配图。禁止外链（必须离线可用）"
    }
  },
  "禁止外链": true
}