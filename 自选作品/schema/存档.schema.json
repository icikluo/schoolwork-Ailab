{
  "$schema_说明": "A4 契约：养成存档与每日状态（localStorage），以及 结算购买/结算打卡 的返回结构",
  "版本": "1.0",
  "存储": {
    "存档": { "键": "食谱搭配-养成存档", "说明": "等级/金币/形象/宠物/已购，跨天保留" },
    "每日": { "键": "食谱搭配-养成每日", "说明": "当天三餐/喝水/运动/购买计数，换天清零" },
    "流水": { "键": "食谱搭配-养成流水", "说明": "经验金币流水，用于展示今日获得" },
    "场景": { "键": "食谱搭配-养成场景", "说明": "墙纸/地板/相机/6 个家具槽位" }
  },
  "存档结构": {
    "版本": { "类型": "integer", "当前值": 1 },
    "经验": { "类型": "integer", "最小": 0 },
    "金币": { "类型": "integer", "最小": 0 },
    "形象": {
      "类型": "object",
      "字段": ["脸型", "肤色", "眉", "眼", "嘴", "腮红", "发型", "上衣", "裤子", "鞋", "配饰"],
      "说明": "每个字段的值必须是 数据/装扮.js 里同类部件的 id"
    },
    "已购": { "类型": "array", "元素类型": "string", "说明": "形如「分类:部件id」" },
    "宠物": {
      "类型": "object|null",
      "字段": {
        "种类": { "类型": "string", "枚举": ["猫", "狗", "兔"] },
        "名字": { "类型": "string", "非空": true },
        "亲密度": { "类型": "integer", "最小": 0, "最大": 100 },
        "领养日": { "类型": "string", "格式": "^\\d{4}-\\d{2}-\\d{2}$" },
        "物品": {
          "类型": "object",
          "字段": { "零食": { "类型": "integer", "最小": 0 }, "玩具": { "类型": "integer", "最小": 0 } }
        }
      }
    },
    "上次打卡日": { "类型": "string|null", "格式": "^\\d{4}-\\d{2}-\\d{2}$" },
    "连续天数": { "类型": "integer", "最小": 0 }
  },
  "每日结构": {
    "日期": { "类型": "string", "格式": "^\\d{4}-\\d{2}-\\d{2}$" },
    "三餐": { "类型": "array", "元素类型": "string", "枚举元素": ["早", "午", "晚"], "唯一": true },
    "喝水": { "类型": "integer", "最小": 0, "最大": 8 },
    "运动": { "类型": "integer", "最小": 0, "最大": 3 },
    "已喂宠物": { "类型": "boolean" },
    "达标": { "类型": "boolean" },
    "购买": { "类型": "object", "说明": "道具id → 当日已购数量，键必须在 数据/商店.js 的 id 集合内" }
  },
  "结算购买返回": {
    "字段顺序": ["存档", "每日", "结果", "价格", "剩余金币"],
    "结果枚举": ["已购买", "金币不足", "已达上限", "无此道具"],
    "价格": { "类型": "integer", "最小": 0, "说明": "无此道具时为 0" },
    "剩余金币": { "类型": "integer", "最小": 0 },
    "不可变性": "任何情况下都不得修改入参对象"
  },
  "结算打卡返回": {
    "字段顺序": ["存档", "每日", "获得", "结果", "升了几级", "是否刚达标"],
    "结果枚举": ["已完成", "已达标", "已上限", "不打卡", "无效来源", "未到餐点"],
    "获得": { "字段": ["经验", "金币"], "类型": "integer", "最小": 0 }
  },
  "不变量": [
    "经验永不受家具加成影响（金币乘 1+加成）",
    "断签只归零连签，不扣经验/等级/物品",
    "每日计数换天清零，存档（等级/金币/形象/宠物）跨天保留"
  ]
}