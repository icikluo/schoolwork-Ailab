{
  "$schema_说明": "A4 契约：装扮部件数据（数据/装扮.js），预设捏脸/换装的唯一数据源",
  "版本": "1.0",
  "文件名": "装扮.js",
  "路径": "数据/装扮.js",
  "JS变量": "window.装扮数据",
  "类型": "object",
  "分类": ["脸型", "肤色", "眉", "眼", "嘴", "腮红", "发型", "上衣", "裤子", "鞋", "配饰"],
  "合计件数": 38,
  "字段顺序": ["id", "名称", "价格", "等级要求", "图层"],
  "肤色额外字段": ["色值"],
  "字段": {
    "id": { "类型": "string", "唯一": true, "格式": "^[脸肤色眉眼嘴红发衣裤鞋饰]-[\\u4e00-\\u9fffA-Za-z0-9]+$" },
    "名称": { "类型": "string", "非空": true },
    "价格": { "类型": "integer", "最小": 0 },
    "等级要求": { "类型": "integer", "最小": 1, "最大": 10 },
    "图层": {
      "类型": "string",
      "允许为空": true,
      "禁止子串": ["<script", "onclick=", "onerror=", "javascript:", "http://", "https://"],
      "说明": "内联 SVG 片段，坐标基于 viewBox 0 0 200 320；肤色分类为空串"
    },
    "色值": {
      "类型": "string",
      "格式": "^#[0-9A-Fa-f]{6}$",
      "仅限分类": ["肤色"]
    }
  },
  "约束": {
    "肤色全免费": "肤色分类内所有部件价格必须为 0（PRD 5.15：收费会让人对自己的样子产生付费焦虑）",
    "坐标基准": "viewBox 0 0 200 320"
  }
}