{
  "$schema_说明": "A4 契约：健身动作数据（数据/动作.js）",
  "版本": "1.0",
  "文件名": "动作.js",
  "路径": "数据/动作.js",
  "JS变量": "window.动作数据",
  "类型": "array",
  "最少条数": 30,
  "字段顺序": ["id", "名称", "部位", "器械", "目标肌群", "要点", "常见错误", "建议", "图片"],
  "字段": {
    "id": { "类型": "string", "格式": "^e\\d{3}$", "唯一": true },
    "名称": { "类型": "string", "非空": true, "唯一": true, "说明": "动作名必须唯一：同名重复会让动作库里出现两张一样的卡片（A4 交接实测踩到）" },
    "部位": {
      "类型": "string",
      "枚举": ["上肢", "下肢", "核心", "全身"],
      "分类最少条数": 2,
      "说明": "四个部位每类至少 2 个动作，保证分区页不为空"
    },
    "器械": {
      "类型": "string",
      "枚举": ["自重", "哑铃", "壶铃", "杠铃", "健身房器械"]
    },
    "目标肌群": { "类型": "string", "非空": true },
    "要点": {
      "类型": "array",
      "元素类型": "string",
      "最少条数": 3,
      "最多条数": 5,
      "非空": true
    },
    "常见错误": {
      "类型": "array",
      "元素类型": "string",
      "最少条数": 1,
      "最多条数": 3
    },
    "建议": { "类型": "string", "非空": true, "说明": "组数与次数，如「3 组 × 12 次」" },
    "图片": {
      "类型": "string",
      "本地路径": true,
      "允许为空": true,
      "最小字节": 1024,
      "说明": "相对 自选作品/ 的本地路径；空串表示用 SVG 示意图兜底"
    }
  },
  "禁止外链": true
}