{
  "$schema_说明": "A4 契约：家具数据（数据/家具.js），6 个槽位的唯一数据源",
  "版本": "1.0",
  "文件名": "家具.js",
  "路径": "数据/家具.js",
  "JS变量": "window.家具数据",
  "类型": "array",
  "条数": 6,
  "字段顺序": ["id", "名称", "价格", "加成", "等级要求", "主色", "默认位置", "图层"],
  "字段": {
    "id": { "类型": "string", "唯一": true, "格式": "^家具-[\\u4e00-\\u9fff]+$" },
    "名称": { "类型": "string", "非空": true },
    "价格": { "类型": "integer", "最小": 0 },
    "加成": { "类型": "number", "枚举数值": [0.05, 0.1], "说明": "金币加成系数，只作用于金币、永不加成经验" },
    "等级要求": { "类型": "integer", "最小": 1, "最大": 10 },
    "主色": { "类型": "string", "格式": "^#[0-9A-Fa-f]{6}$" },
    "默认位置": {
      "类型": "object",
      "字段": { "x": { "类型": "number" }, "z": { "类型": "number" } },
      "说明": "3D 房间世界坐标；2.5D 降级时按同一份数据投影"
    },
    "图层": { "类型": "string", "禁止子串": ["<script", "onclick=", "http://", "https://"] }
  },
  "约束": {
    "加成合计上限": 0.5,
    "加成合计": 0.35,
    "同件不可重复摆放": true
  }
}